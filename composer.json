{
  "name": "pservice/pservice",
  "type": "project",
  "description": "PService - registro fotográfico de ordens de serviço",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^13.0",
    "intervention/image-laravel": "^1.0"
  },
  "require-dev": {
    "laravel/pint": "^1.24",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "scripts": {
    "post-autoload-dump": [
      "@php artisan package:discover --ansi"
    ]
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
