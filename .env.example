APP_NAME=PService
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://pservice.seudominio.com.br
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_TIMEZONE=America/Sao_Paulo

LOG_CHANNEL=daily
LOG_LEVEL=warning

# SQLite: sem DB_DATABASE usa database/database.sqlite. Em produção o instalador grava o caminho absoluto.
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=pservice
# DB_USERNAME=pservice
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=480
# true somente depois que o HTTPS estiver ativo (o instalador ajusta sozinho com CERTBOT_EMAIL)
SESSION_SECURE_COOKIE=false

FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# Recuperação de senha: troque "log" por "smtp" e preencha os dados do provedor.
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=smtp.seuprovedor.com.br
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@pservice.local
MAIL_FROM_NAME=PService

# Tamanho máximo por foto, em KB (40960 = 40 MB)
PSERVICE_UPLOAD_MAX_KB=40960

# Snapshots locais do banco
BACKUP_RETENTION_DAYS=14
# Destino rclone para cópia FORA da VPS (fotos + banco). Ex: b2:pservice-backup
BACKUP_RCLONE_REMOTE=
